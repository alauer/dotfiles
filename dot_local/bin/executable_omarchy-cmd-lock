#!/usr/bin/env sh
# omarchy-cmd-lock — Phase R lockscreen chokepoint.
#
# Single chokepoint for manual lock (SUPER+L keybind in hyprland.lua) and
# walk-away auto-lock (hypridle listener @60s and idle-triggered suspend
# path). Both paths converge here.
#
# Pattern (canonical per Hyprland wiki hypridle.md):
#   pidof hyprlock || hyprlock
# — at most one hyprlock instance running; the user always has a way to
# authenticate. Replaces the prior LockedHint short-circuit which had a
# corner case: if hyprlock crashed while LockedHint=yes (Hyprland engaged
# session-lock-v1 but no UI), the user was left with a black locked screen
# and no way to authenticate. The canonical pattern re-spawns hyprlock.
#
# XDG_CONFIG_HOME defense: hyprlock exits with "Config path error" if it
# can't find hyprlock.conf. Hyprland's environment does not export
# XDG_CONFIG_HOME, so we set it defensively before exec.
#
# Swaylock remains available as a CLI emergency escape hatch:
#   $ swaylock

set -u

# Defensively ensure XDG_CONFIG_HOME is set so hyprlock can locate its config.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME:-/home/aaron}/.config}"

# Canonical pattern: at most one hyprlock running. Re-spawns hyprlock if
# it died mid-session so the user always has a UI to authenticate against.
pidof hyprlock >/dev/null 2>&1 || exec hyprlock
# If we got here, hyprlock was already running — no-op success.
exit 0