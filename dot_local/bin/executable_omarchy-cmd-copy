#!/bin/bash
# Omarchy unified clipboard: COPY
# Sends Ctrl+Shift+C to terminals, Ctrl+C to everything else.
# Routes via window class so the focused app interprets the keystroke.
set -euo pipefail

CLASS=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // ""')

case "$CLASS" in
  com.mitchellh.ghostty|kitty|foot|alacritty|org.wezfurlong.wezterm|org.gnome.Terminal|xterm|urxvt|st-256color)
    wtype -M ctrl -M shift -k c
    ;;
  *)
    wtype -M ctrl -k c
    ;;
esac
