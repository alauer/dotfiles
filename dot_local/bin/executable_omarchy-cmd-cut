#!/bin/bash
# Omarchy unified clipboard: CUT
# No-op in terminals (Omarchy spec: "Cut (not in terminal)") — Ctrl+X elsewhere.
set -euo pipefail

CLASS=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // ""')

case "$CLASS" in
  com.mitchellh.ghostty|kitty|foot|alacritty|org.wezfurlong.wezterm|org.gnome.Terminal|xterm|urxvt|st-256color)
    exit 0
    ;;
  *)
    wtype -M ctrl -k x
    ;;
esac
