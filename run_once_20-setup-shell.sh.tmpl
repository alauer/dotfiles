#!/usr/bin/env bash
# shellcheck shell=bash
# shellcheck disable=SC2034,SC1090
{{ if eq .chezmoi.os "linux" -}}

# Starship
sh -c "$(curl -fsSL https://starship.rs/install.sh)" -f -y -b $HOME/bin

#EZA
if [ ! -f "/usr/bin/eza" ]; then
EZA_VERSION=$(curl -s "https://api.github.com/repos/eza-community/eza/releases/latest" | grep -Po '"tag_name": "v\K[0-9.]+')
{{ if eq .chezmoi.arch "arm64" -}}
curl -Lo /tmp/eza.zip "https://github.com/eza-community/eza/releases/latest/download/eza_x86_64-unknown-linux-gnu.zip"
{{ else if eq .chezmoi.arch "amd64"}}
curl -Lo /tmp/eza.zip "https://github.com/eza-community/eza/releases/latest/download/eza_arm-unknown-linux-gnueabihf.zip"
{{ end -}}
unzip -q /tmp/eza.zip bin/eza -d "$HOME"
fi

#AWS CLI
if [ ! -d "$HOME/.aws-cli/v2/current" ]; then
{{ if eq .chezmoi.arch "arm64" -}}
curl "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o "/tmp/awscliv2.zip"
{{ else if eq .chezmoi.arch "amd64"}}
curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "/tmp/awscliv2.zip"
{{ end -}}
unzip -qq /tmp/awscliv2.zip -d /tmp/
/tmp/aws/install -i "$HOME"/.aws-cli -b "$HOME"/bin
fi

#Set Shell
#{{ if eq .email "lauer.aaron@gmail.com" -}}
#chsh -s $(which fish)
#{{else -}}
#sudo chsh -s `which zsh` {{ .chezmoi.username }}
#chsh -s $(which zsh)
#{{- end}}
{{end -}}
